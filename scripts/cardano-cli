#!/bin/bash

# This script acts as a front end for cardano-cli. If it finds an actual cardano-cli binary
# outside this directory in the PATH, it will invoke that binary with the supplied arguments.
# If it doesn't find a cardano-cli binary, it will run cardano-cli in a docker container,
# mounting the appropriate volumes and setting the proper environment variables.

unset clipath
for i in $(echo "$PATH" | sed 's/:/ /g'); do 
  if [[ $i != ${DEVNET_ROOT}* ]]; then
    if [ -x $i/cardano-cli ]; then
      clipath=$i
      break
    fi
  fi
done

newargs=()
for i in "${@:1}"; do
  tmp=$i
  if [[ $i == ${DEVNET_ROOT}* ]]; then
    tmp=("${i#$DEVNET_ROOT}")
  fi
  if [[ $i == ${CARDANO_CLI_GURU}* ]]; then
    tmp=("${i#$CARDANO_CLI_GURU}")
  fi
  newargs+=("${tmp}")
done

if [ -z ${clipath+x} ]; then
  # cardano-cli not in PATH external to this directory.
  # If CARDANO_NODE_SOCKET_PATH points at a live socket outside the devnet
  # runtime (e.g. an isolated fork-mode run under /mnt/cardano/runs), mount that
  # directory over /runtime/ipc so the containerised cli talks to that node.
  if [ -S "${CARDANO_NODE_SOCKET_PATH:-}" ] &&
     [ "$(dirname "$CARDANO_NODE_SOCKET_PATH")" != "$DEVNET_ROOT/runtime/ipc" ]; then
    export ISOLATED_IPC=$(dirname "$CARDANO_NODE_SOCKET_PATH")
  fi
  # Same for --socket-path (either form), which takes precedence over the env
  # var as it does for cardano-cli itself: mount the socket's directory over
  # /runtime/ipc and point the flag at the socket there. args and newargs line
  # up one to one, so the index from one rewrites the other.
  args=("$@")
  for ((n = 0; n < ${#args[@]}; n++)); do
    case ${args[n]} in
      --socket-path)   sock=${args[n+1]:-}; at=$((n+1)); pre= ;;
      --socket-path=*) sock=${args[n]#--socket-path=}; at=$n; pre=--socket-path= ;;
      *) continue ;;
    esac
    [ -n "$sock" ] || continue
    sock=$(realpath -m "$sock")
    dir=$(dirname "$sock")
    if [ "$dir" = "$DEVNET_ROOT/runtime/ipc" ]; then
      # the devnet's own socket: undo any remount from the env var
      unset ISOLATED_IPC
      newargs[at]=$pre/runtime/ipc/$(basename "$sock")
    elif [ -d "$dir" ]; then
      # only an existing dir: docker would create a missing one as root
      export ISOLATED_IPC=$dir
      newargs[at]=$pre/runtime/ipc/$(basename "$sock")
    fi
  done
  exec docker compose -f $DEVNET_ROOT/docker-compose.yml run --rm -T cardano-cli "${newargs[@]}"
else 
  exec $clipath/cardano-cli "${@:1}"
fi
