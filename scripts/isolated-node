#!/bin/bash

# Start (or stop) the patched cardano-node in an isolated container: no network
# namespace, no fork env vars, producer keys loaded. The node can neither reach
# nor be reached by any other node; the Unix socket in <run dir>/ipc is the only
# way in or out.
#
# Usage:
#   isolated-node start <run>        # run dir must contain chain/ db/ ipc/
#   isolated-node stop [<run>]
#   isolated-node logs [<run>] [-f]
#   isolated-node cli [--run <run>] <cardano-cli args...>
#   isolated-node status [<run>]     # fork containers and their runs
#   isolated-node rm <run>           # delete a run dir and its stopped containers
#
# <run> is a run name as given to new-run (mark-test, or run-mark-test,
# means $RUNS_DIR/run-mark-test), or a path to a run dir if it contains a slash.
#
# Several forks can run at once. Each run directory gets its own container,
# named devnet-fork-<run suffix>, in its own compose project. stop, logs and cli
# take an optional <run>; if exactly one fork is running they default to it,
# and otherwise they list what is running and stop.
#
# The run directory is a copy of the golden DB plus an isolated config; never
# point this at the golden DB itself.
#
# If <run dir>/chain/faketime.env exists (written by scripts/set-faketime),
# the container's clock is shifted via LD_PRELOAD'd libfaketime so "now" lands
# just past a stale DB's tip, inside the ledger's forecast horizon -- lets a
# forging run resume without waiting on a real DB re-sync. No such file =>
# real clock, unchanged from before. That file may also carry a rate multiplier
# and FAKETIME_DONT_FAKE_MONOTONIC (see scripts/set-faketime --rate).

set -euo pipefail

DEVNET_ROOT=${DEVNET_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}
export MY_UID=${MY_UID:-$(id -u)}
export MY_GID=${MY_GID:-$(id -g)}

RUNS=${RUNS_DIR:-/mnt/cardano/runs}

# existing dir -> absolute path (GNU realpath -e, but portable to BSD/macOS)
abs_dir() { (cd "$1" 2>/dev/null && pwd) || { echo "no such run dir: $1" >&2; return 1; } }

# <run> -> existing run dir, accepting what devnet-fork's resolve_run does
run_dir() {
  case $1 in
    */*)   abs_dir "$1" ;;
    run-*) abs_dir "$RUNS/$1" ;;
    *)     abs_dir "$RUNS/run-$1" ;;
  esac
}

# run dir -> container name. One mapping, used by every script that needs it.
container_for() { local b; b=$(basename "${1%/}"); echo "devnet-fork-${b#run-}"; }

# Which forks are up, by label rather than by name pattern.
running_forks() { docker ps --filter 'label=devnet.fork=producer' --format '{{.Names}}'; }

# The run directory a running container was started against.
rundir_of() {
  docker inspect "$1" --format \
    '{{range .Mounts}}{{if eq .Destination "/rundir"}}{{.Source}}{{end}}{{end}}' 2>/dev/null
}

# Resolve which fork a non-start subcommand means.
resolve_container() {
  if [ -n "${1:-}" ]; then container_for "$1"; return; fi
  local names; names=$(running_forks)
  case "$(echo "$names" | grep -c .)" in
    1) echo "$names" ;;
    0) echo "no fork is running" >&2; return 1 ;;
    *) echo "several forks are running; name one:" >&2
       echo "$names" | sed 's/^/  /' >&2; return 1 ;;
  esac
}

cmd=${1:-}; shift || true

case "$cmd" in
  start)
    rundir=$(run_dir "${1:?usage: isolated-node start <run>}")
    # never run against the golden DB: it is the one copy of the synced chain
    golden=$(realpath "${GOLDEN_DB:-/mnt/cardano/preview}" 2>/dev/null || true)
    if [ -n "$golden" ] && [ "$rundir" = "$golden" -o "$rundir/db" = "$golden" ]; then
      echo "refusing: $rundir is the golden DB. Clone it first:" >&2
      echo "  cp -a --reflink=always $golden/db <run dir>/db" >&2
      exit 1
    fi
    for d in chain db ipc; do
      [ -d "$rundir/$d" ] || { echo "missing $rundir/$d" >&2; exit 1; }
    done
    export ISOLATED_RUN_DIR=$rundir
    export ISOLATED_CONTAINER_NAME=$(container_for "$rundir")
    # a distinct compose project per fork, or compose would treat a second fork
    # as a replacement for the first rather than an addition
    COMPOSE="docker compose -p $ISOLATED_CONTAINER_NAME -f $DEVNET_ROOT/docker-compose.yml --profile isolated"
    echo "container: $ISOLATED_CONTAINER_NAME"
    # fork gates, if this run defines them
    if [ -f "$rundir/chain/fork.env" ]; then
      export ISOLATED_ENV_FILE=$rundir/chain/fork.env
      echo "fork env: $ISOLATED_ENV_FILE"
      sed 's/^/  /' "$ISOLATED_ENV_FILE"
    else
      echo "fork env: none (gates unset)"
    fi
    # faked clock, if scripts/set-faketime wrote one for this run
    if [ -f "$rundir/chain/faketime.env" ]; then
      export ISOLATED_FAKETIME_ENV_FILE=$rundir/chain/faketime.env
      echo "faketime env: $ISOLATED_FAKETIME_ENV_FILE"
      sed 's/^/  /' "$ISOLATED_FAKETIME_ENV_FILE"
      # compose's `environment:` beats `env_file:`, so this one key cannot be
      # delivered by the env file -- lift it out and hand it to compose as a
      # shell variable instead. The file stays the record of what the run used.
      export ISOLATED_DONT_FAKE_MONOTONIC=$(
        sed -n 's/^FAKETIME_DONT_FAKE_MONOTONIC=//p' "$ISOLATED_FAKETIME_ENV_FILE" | tail -1)
      export ISOLATED_DONT_FAKE_MONOTONIC=${ISOLATED_DONT_FAKE_MONOTONIC:-1}
    else
      echo "faketime env: none (real clock)"
    fi
    # the stopped container is kept around so its log survives; recreate it so
    # this run's config and mounts take effect
    $COMPOSE up -d --force-recreate cardano-node-isolated
    echo "started; socket at $rundir/ipc/node.socket"
    ;;
  stop)
    # image STOPSIGNAL is SIGINT, so this is a clean shutdown. The container is
    # deliberately NOT removed: docker logs still works afterwards, which is
    # what you want after a failed fork run.
    name=$(resolve_container "${1:-}") || exit 1
    sock=$(docker inspect "$name" \
             --format '{{range .Mounts}}{{if eq .Destination "/ipc"}}{{.Source}}{{end}}{{end}}' \
             2>/dev/null)/node.socket
    docker stop "$name"
    # drop the stale socket file so probing a stopped run fails honestly
    # ("No such file or directory" rather than "Connection refused")
    [ -S "$sock" ] && rm -f "$sock" && echo "removed stale socket $sock"
    ;;
  logs)
    # a leading run dir or fork name selects which; anything else goes to docker
    case "${1:-}" in
      -*|"") name=$(resolve_container "") || exit 1 ;;
      *) name=$(container_for "$1"); shift ;;
    esac
    docker logs "$@" "$name"
    ;;
  cli)
    # cardano-cli in the same image, sharing the node's ipc dir and network
    # namespace (none), so it reaches the node only through the socket
    sel=""
    if [ "${1:-}" = "--run" ]; then sel=$2; shift 2; fi
    name=$(resolve_container "$sel") || exit 1
    docker run --rm -i \
      --network "container:$name" \
      --user "$MY_UID:$MY_GID" \
      --volumes-from "$name" \
      -e CARDANO_NODE_SOCKET_PATH=/ipc/node.socket \
      --entrypoint /usr/local/bin/cardano-cli \
      "${DEVNET_IMAGE:-ghcr.io/cryptophonic/cardano-node-ogmios:v7.0.0_11.1.3-forkmode-d462a8ea9}" \
      "$@"
    ;;
  status)
    # every fork container (producer, follower, ogmios), found by label; with a
    # <run>, only that run's, plus its socket and gates
    rundir=""
    filter=(--filter label=devnet.fork)
    if [ -n "${1:-}" ]; then
      rundir=$(run_dir "$1")
      filter=(--filter "label=devnet.fork.run=$rundir")
    fi
    rows=$(docker ps -a "${filter[@]}" --format \
      '{{.Label "devnet.fork.run"}}|{{.Label "devnet.fork"}}|{{.Names}}|{{.State}}|{{.Status}}')
    if [ -z "$rows" ]; then
      echo "no fork containers${rundir:+ for $rundir}"
    else
      runs=$( (cd "$RUNS" 2>/dev/null && pwd) || echo "$RUNS")
      # header as a first row rather than column -N, which macOS column lacks
      { echo 'RUN|ROLE|CONTAINER|STATUS'
        while IFS='|' read -r run role name state status; do
          [ "$(dirname "$run")" = "$runs" ] && run=${run##*/run-}
          printf '%s|%s|%s|%s\n' "$run" "$role" "$name" "$status"
        done <<<"$rows" | sort
      } | column -t -s'|'
    fi
    if [ -n "$rundir" ]; then
      if [ -S "$rundir/ipc/node.socket" ]; then
        grep -q '|producer|[^|]*|running|' <<<"$rows" && stale= || stale=" (stale: node is not running)"
        echo "socket: $rundir/ipc/node.socket$stale"
      fi
      if [ -f "$rundir/chain/fork.env" ]; then
        echo "fork:   $(paste -sd' ' "$rundir/chain/fork.env")"
      else
        echo "fork:   none (gates unset)"
      fi
    fi
    # success iff some producer is running
    grep -q '|producer|[^|]*|running|' <<<"$rows"
    ;;
  rm)
    rundir=$(run_dir "${1:?usage: isolated-node rm <run>}")
    runs=$(abs_dir "$RUNS") || exit 1
    # only ever a run-* dir directly under the runs dir: never the golden DB,
    # never runs/keys
    if [ "$(dirname "$rundir")" != "$runs" ] || [[ $(basename "$rundir") != run-* ]]; then
      echo "refusing: $rundir is not a run dir (expected $runs/run-*)" >&2
      exit 1
    fi
    # producer, follower and ogmios containers all carry the run as a label
    up=$(docker ps --filter "label=devnet.fork.run=$rundir" --format '{{.Names}}')
    if [ -n "$up" ]; then
      echo "refusing: $rundir is in use by running containers; stop them first:" >&2
      echo "$up" | sed 's/^/  /' >&2
      exit 1
    fi
    # the kept containers' logs belong to this run; they go with it
    docker ps -a --filter "label=devnet.fork.run=$rundir" --format '{{.ID}} {{.Names}}' |
      while read -r id cname; do
        docker rm "$id" >/dev/null && echo "removed container $cname"
      done
    rm -rf "$rundir"
    echo "removed $rundir"
    ;;
  *)
    sed -n '3,32p' "$0"
    exit 1
    ;;
esac
