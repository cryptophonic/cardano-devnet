#!/bin/bash

# Top-level devnet command. Dispatches to scripts/devnet-<group>.
#
# Usage:
#   devnet fork <subcommand> ...    # fork-mode lifecycle (see: devnet fork)
#
# Everything else in scripts/ is still its own entry point on PATH
# (start-cardano-devnet, monitor, indexer, explorer, fund, ...); this wrapper
# exists for command groups that need subcommands, not to replace them.

set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)

group=${1:-}; shift || true

case "$group" in
  fork) exec "$HERE/devnet-fork" "$@" ;;
  ""|-h|--help|help)
    sed -n '3,10p' "$0"
    exit 1
    ;;
  *)
    echo "devnet: unknown command group '$group'" >&2
    sed -n '3,10p' "$0" >&2
    exit 1
    ;;
esac
