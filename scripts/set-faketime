#!/bin/bash

# Write (or clear) <run dir>/chain/faketime.env, which scripts/isolated-node
# picks up automatically: it shifts the isolated node's clock via LD_PRELOAD'd
# libfaketime (docker/Dockerfile, scripts/build-faketime) so "now" lands just
# past a stale DB's tip -- inside the ledger's ~7.2h forecast horizon on
# preview -- instead of failing leadership checks with NoLedgerView /
# CurrentSlotUnknown against a chain that real time has left behind.
#
# Usage:
#   set-faketime <run dir>              # derive from THIS run's container's own
#                                        # last logged tip (the time IT believed
#                                        # it was at) -- run this right after
#                                        # `isolated-node stop`
#   set-faketime <run dir> --slot <N>   # derive from an explicit slot instead
#   set-faketime <run dir> --clear      # remove faketime.env (back to real clock)
#
# Options (combine with either form above):
#   --rate <X>          run the container's clock X times real speed, so a chain
#                       hour costs a real minute at X=60. libfaketime anchors the
#                       speed-up at process start, so the node sees
#                       target + X*(real seconds since it started).
#   --stamp             put the clock spec in <run dir>/chain/faketime.stamp and
#                       point libfaketime at it (FAKETIME_TIMESTAMP_FILE) instead
#                       of baking it into FAKETIME. The node re-reads that file
#                       while it runs, so the clock can be changed WITHOUT a
#                       restart -- which is what `devnet fork warp` uses, and what
#                       lets a follower be synchronised after it is already up
#                       rather than guessing a lead. See
#                       test/fixtures/fork-mode-clock-signal.md.
#                       Note a rewrite RE-ANCHORS the speed-up at the moment the
#                       file is read, so a stamp is "the clock is X now", not an
#                       offset to add to wherever the clock had got to.
#                       Never combine with FAKETIME_NO_CACHE: that re-reads on
#                       every clock call and hangs cardano-node (fixture 10b).
#   --fake-monotonic    also accelerate CLOCK_MONOTONIC (default: leave it real).
#                       CLOCK_MONOTONIC is what consensus and the mux build their
#                       timers on, so this is the knob that decides whether the
#                       node's *timers* speed up with its wall clock or stay at
#                       real pace while wall time runs away from them. Which one
#                       a given rate wants is an empirical question -- measure it.
#
# Slot and wall-clock are exactly 1:1 on preview (slotLength=1s):
#   time = systemStart + slot seconds, systemStart from shelley-genesis.json.
# Don't reconstruct this from era history elsewhere; it's already this simple.
#
# Precision doesn't matter much -- the horizon is hours wide -- so this adds a
# LEAD_SECONDS cushion (default 10) past the derived slot rather than landing
# exactly on it.
#
# NOTE: the run's operational certificate must be issued at the KES period
# that covers the faketime target, not the period covering real "now". A run
# created fresh for a faketime test should pass FORK_NOW to
# scripts/new-isolated-run (see its usage) rather than relying on this script
# to fix up an already-issued opcert.

set -euo pipefail

LEAD=${LEAD_SECONDS:-10}

rundir=${1:?usage: set-faketime <run dir> [--slot <N> | --clear] [--rate X] [--fake-monotonic]}
shift
rundir=$(realpath "$rundir")
[ -d "$rundir/chain" ] || { echo "missing $rundir/chain" >&2; exit 1; }
out=$rundir/chain/faketime.env

slot=
rate=
stamp=
dont_fake_monotonic=1
stampfile=$rundir/chain/faketime.stamp
while [ $# -gt 0 ]; do
  case "$1" in
    --clear) rm -f "$out" "$stampfile"; echo "removed $out (real clock)"; exit 0 ;;
    --stamp) stamp=1; shift ;;
    --slot)  slot=${2:?--slot needs a slot number}; shift 2 ;;
    --rate)  rate=${2:?--rate needs a multiplier}; shift 2 ;;
    --fake-monotonic) dont_fake_monotonic=0; shift ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
done

if [ -z "$slot" ]; then
  # this run's own container, not a fixed name: several forks can be running
  container=devnet-fork-$(basename "$rundir" | sed 's/^run-//')
  slot=$(docker logs "$container" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' \
         | grep -a 'Chain extended' | tail -1 | grep -oE 'at slot [0-9]+' | grep -oE '[0-9]+')
  [ -n "$slot" ] || {
    echo "no 'Chain extended' line in $container's logs; pass --slot <N> explicitly" >&2
    exit 1
  }
fi

faketime=$(python3 -c "
import datetime, json
g = json.load(open('$rundir/chain/shelley-genesis.json'))
s = datetime.datetime.strptime(g['systemStart'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
t = s + datetime.timedelta(seconds=$slot + $LEAD)
print(f'@{t:%Y-%m-%d %H:%M:%S}')
")

# libfaketime spells a speed-up as a trailing " x<rate>" on the FAKETIME string
[ -n "$rate" ] && faketime="$faketime x$rate"

if [ -n "$stamp" ]; then
  # The spec lives in a file the node re-reads, so a later write moves a RUNNING
  # node's clock. CACHE_DURATION bounds how stale a read may be; NO_CACHE would
  # re-read on every clock call and hangs the node.
  echo "$faketime" > "$stampfile"
  cat > "$out" <<EOF
LD_PRELOAD=/opt/faketime/libfaketime.so.1
FAKETIME_TIMESTAMP_FILE=/rundir/chain/faketime.stamp
FAKETIME_CACHE_DURATION=${FAKETIME_CACHE_DURATION:-2}
FAKETIME_DONT_FAKE_MONOTONIC=$dont_fake_monotonic
EOF
  echo "wrote $stampfile:"; sed 's/^/  /' "$stampfile"
  echo "wrote $out:"; sed 's/^/  /' "$out"
else
  cat > "$out" <<EOF
LD_PRELOAD=/opt/faketime/libfaketime.so.1
FAKETIME=$faketime
FAKETIME_DONT_FAKE_MONOTONIC=$dont_fake_monotonic
EOF
  echo "wrote $out:"; sed 's/^/  /' "$out"
fi
echo "(from slot $slot + ${LEAD}s lead${rate:+, rate x$rate}\
$([ "$dont_fake_monotonic" = 0 ] && echo ', CLOCK_MONOTONIC faked too')\
$([ -n "$stamp" ] && echo ', stamp-file mode'))"
