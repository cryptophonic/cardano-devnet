#!/bin/bash

# Fork-mode lifecycle. A fork IS a run: the fork directory is the existing
# numbered run directory (RUNS_DIR, default /mnt/cardano/runs), and
# manifest.json sits beside chain/fork.env and chain/faketime.env. There is no
# separate forks/ tree.
#
# Usage:
#   devnet fork create --name <n> --network preview|preprod|mainnet
#                      --from db:<path>|mithril
#                      [--slot S] [--rate R] [--block-every B]
#   devnet fork adopt <run>            # derive a manifest for an existing run
#   devnet fork start <n> [--rate R]   # start the producer
#   devnet fork stop [<n>]
#   devnet fork status [<n>]
#   devnet fork warp <n> --to-slot S | --to-epoch E [--rate R]
#   devnet fork rate <n> <r>           # change a running fork's clock rate
#   devnet fork seeds <n> [--candidates <file>]  # verify known-funded test addresses
#   devnet fork reset <n>              # back to the fork point
#   devnet fork list
#   devnet fork follow <manifest path> # start a follower beside the producer
#   devnet fork ogmios start|stop|status|url [<n>]   # the fork's ogmios sidecar
#   devnet fork clock [<n>]            # the forger's own faked clock, as JSON
#
# <n> is a fork name; the directory is <RUNS_DIR>/run-<n>. A run directory
# path is accepted anywhere a name is.
#
# This wraps scripts/new-isolated-run, scripts/isolated-node,
# scripts/set-faketime and scripts/follower-node rather than duplicating them.
# Two things it does that they do not: it defaults the accelerated clock to
# Arm 2 (CLOCK_MONOTONIC faked -- fixture fork-mode-rate-and-epoch.md 9a shows
# Arm 1 forges 16 blocks where Arm 2 forges 951), and it scales the mempool
# admission timeouts by the rate (9c: unscaled, every tx fails
# MempoolTxTooSlow).
#
# Several forks run at once. Each run directory gets its own container,
# devnet-fork-<run suffix>, in its own compose project, and tooling finds them by
# the docker label devnet.fork=producer rather than by name. Subcommands that
# take no fork name default to the sole running one and otherwise list them.
#
# The node itself keeps network_mode: none, so nothing is published per fork and
# the phase-8 isolation property is untouched however many are running. Sidecars
# (ogmios, provider, explorer) reach a fork over its Unix socket in <run>/ipc,
# not over its network namespace -- which is what lets one published entry point
# serve many forks.
#
# Env: RUNS_DIR, GOLDEN_DB, CARDANO_CLI_BIN, DEVNET_IMAGE, FORK_MEM_FLOOR_MB,
#      FORK_NODE_RSS_MB, FOLLOWER_MARGIN_SLOTS, WARP_TIMEOUT.

set -euo pipefail

DEVNET_ROOT=${DEVNET_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}
SCRIPTS=$DEVNET_ROOT/scripts
RUNS=${RUNS_DIR:-/mnt/cardano/runs}
CLI=${CARDANO_CLI_BIN:-/mnt/cardano/bin/node-11.1.2/bin/cardano-cli}
TOOLBIN=$(dirname "$CLI")
IMAGE=${DEVNET_IMAGE:-ghcr.io/cryptophonic/cardano-node-ogmios:v7.0.0_11.1.2-custom-cb30ce58-faketime}
# run dir -> container name, the same mapping scripts/isolated-node uses
container_for() { local b; b=$(basename "${1%/}"); echo "devnet-fork-${b#run-}"; }
# Approximate RSS of one preview node, measured (fixture notes): 1.74 GiB.
NODE_RSS_MB=${FORK_NODE_RSS_MB:-1800}

# The shared bridge fork sidecars sit on. External to every fork's compose
# project, created on demand; see docker-compose.yml.
FORKS_NET=${FORKS_NET:-devnet-forks}

# Security parameter k from preview's shelley genesis. Below k fork blocks a
# reset can just drop volatile/; at or above it a fork block has reached the
# ImmutableDB and only db-truncater can unfork (fixture fork-mode-unfork.md).
SECURITY_PARAM=432

# Base mempool admission timeouts in seconds, scaled by the rate at start.
MEMPOOL_SOFT=1
MEMPOOL_HARD=1.5
MEMPOOL_CAPACITY=5

usage() { sed -n '3,33p' "$0"; exit "${1:-1}"; }
die() { echo "devnet fork: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers

# Accept a bare name, a run-<name> directory name, or a path.
resolve_run() {
  local n=$1
  case "$n" in
    */*) realpath "$n" ;;
    run-*) echo "$RUNS/$n" ;;
    *) echo "$RUNS/run-$n" ;;
  esac
}

manifest_of() { echo "$(resolve_run "$1")/manifest.json"; }

require_manifest() {
  local m; m=$(manifest_of "$1")
  [ -f "$m" ] || die "no manifest at $m -- run 'devnet fork adopt $1' first"
  echo "$m"
}

# Read one dotted key out of a manifest.
mget() {
  python3 -c "
import json,sys
o=json.load(open(sys.argv[1]))
for k in sys.argv[2].split('.'):
    o = o.get(k) if isinstance(o, dict) else None
    if o is None: break
print('' if o is None else (json.dumps(o) if isinstance(o,(dict,list)) else o))
" "$1" "$2"
}

# Every running fork producer, as run directories, one per line.
running_fork_dirs() {
  docker ps --filter 'label=devnet.fork=producer' --format '{{.Names}}' \
    | while read -r n; do
        [ -n "$n" ] || continue
        docker inspect "$n" --format \
          '{{range .Mounts}}{{if eq .Destination "/rundir"}}{{.Source}}{{end}}{{end}}' 2>/dev/null
      done
}

# Is this particular fork running?
fork_running() {
  docker inspect -f '{{.State.Running}}' "$(container_for "$1")" 2>/dev/null | grep -qx true
}

running_fork_count() { running_fork_dirs | grep -c . || true; }

# Which fork a subcommand means: the named one, else the sole running one.
resolve_running() {
  if [ -n "${1:-}" ]; then resolve_run "$1"; return; fi
  local dirs; dirs=$(running_fork_dirs)
  case "$(echo "$dirs" | grep -c .)" in
    1) echo "$dirs" ;;
    0) die "no fork producer running; name one" ;;
    *) die "several forks are running; name one:
$(echo "$dirs" | sed 's/^/  /')" ;;
  esac
}

# blockEvery that holds ~5 blocks/s at a given rate, floored at 1 slot.
block_every_for_rate() {
  python3 -c "print(max(1, round($1/5)))"
}

# Manifests store the rate as a JSON number, so it reads back as "100.0";
# libfaketime wants "x100". Trim the trailing .0.
rate_str() { python3 -c "r=float('$1'); print(int(r) if r==int(r) else r)"; }

mem_floor_mb() {
  local network=$1
  if [ -n "${FORK_MEM_FLOOR_MB:-}" ]; then echo "$FORK_MEM_FLOOR_MB"; return; fi
  case "$network" in
    # one node plus working room; not a whole-host budget
    preview|preprod) echo 3000 ;;
    # Unmeasured. Refuse rather than guess: a mainnet node's working set is
    # the thing an engagement gets priced on.
    mainnet) echo "" ;;
    *) echo 3000 ;;
  esac
}

# Several forks can run at once, so the guard is about headroom for ONE MORE
# node, not a single global floor. A preview node measured 1.74 GiB resident.
check_memory() {
  local network=$1 what=$2 floor avail running
  floor=$(mem_floor_mb "$network")
  avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
  running=$(running_fork_count)
  if [ -z "$floor" ]; then
    die "no measured memory floor for $network; $what refuses to guess.
  Set FORK_MEM_FLOOR_MB=<megabytes> once you have measured it."
  fi
  if [ "$avail" -lt "$floor" ]; then
    die "$what needs ${floor}MB free for another node, host has ${avail}MB with \
$running fork(s) already running.
  Stop one (devnet fork stop <n>), or override with FORK_MEM_FLOOR_MB."
  fi
  echo "memory: ${avail}MB available, need ${floor}MB, $running fork(s) running -- ok"
}

# Slot <-> time, and epoch, from a run's own shelley genesis. Preview is
# slotLength=1 so this is exact; do not reconstruct it from era history.
genesis_py() {
  cat <<'PY'
import datetime, json, sys
g = json.load(open(sys.argv[1]))
START = datetime.datetime.strptime(g['systemStart'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
SLOT_LEN = g['slotLength']
EPOCH_LEN = g['epochLength']
KES_SLOTS = g['slotsPerKESPeriod']
KES_MAX = g['maxKESEvolutions']
def slot_to_time(s): return START + datetime.timedelta(seconds=s * SLOT_LEN)
def epoch_of(s): return int(s // EPOCH_LEN)
def kes_of(s): return int(s // KES_SLOTS)
PY
}

# The ImmutableDB tip, without starting a node: resume from the newest on-disk
# ledger snapshot (directory names are slot numbers) so only the tail is
# replayed -- under a second on a preview DB.
#
# This is NOT the chain tip. db-analyser reads the ImmutableDB only, and the
# last ~k blocks of a synced chain live in the VolatileDB: on the preview
# golden DB the ImmutableDB tip is slot 123360598 while the node's own tip is
# 123372484, ~11900 slots further on. Use chaindb_tip for the fork point.
probe_immutable_tip() {
  local db=$1 config=$2 from
  from=$(ls -1 "$db/ledger" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1)
  [ -n "$from" ] || die "no ledger snapshot in $db/ledger to resume from; pass --slot explicitly"
  "$TOOLBIN/db-analyser" --db "$db" --config "$config" \
      --analyse-from "$from" --count-blocks \
      --db-validation minimum-block-validation --lsm 2>&1 \
    | sed -n 's/.*blockPointSlot = SlotNo \([0-9]*\).*blockPointHash = \([0-9a-f]*\).*/\1 \2/p' \
    | tail -1
}

# The node's OWN selected tip, volatile blocks included -- the natural fork
# point, and the only way to get it is to ask a node. Never against the golden
# DB, so this works on a throwaway reflink clone with the fork gates unset: a
# gate at the wrong slot would make the node reject the very blocks we are
# trying to measure. `query tip` answers from the ChainDB, so a DB that real
# time has left far behind still reports its tip.
chaindb_tip() {
  local source=$1 magic=$2 probe_name=${3:-tipprobe-$$} probe
  probe=$RUNS/run-$probe_name

  # shellcheck disable=SC2064
  trap "\"$SCRIPTS/isolated-node\" stop >/dev/null 2>&1 || true; rm -rf '$probe'" RETURN
  rm -rf "$probe"
  GOLDEN_DB=$source RUNS_DIR=$RUNS CARDANO_CLI_BIN=$CLI \
    "$SCRIPTS/new-isolated-run" "$probe_name" >/dev/null
  "$SCRIPTS/isolated-node" start "$probe" >/dev/null 2>&1

  local tip=""
  local deadline=$(( SECONDS + ${TIP_PROBE_TIMEOUT:-300} ))
  while [ $SECONDS -lt $deadline ]; do
    tip=$("$SCRIPTS/isolated-node" cli latest query tip --testnet-magic "$magic" 2>/dev/null || true)
    case "$tip" in *'"slot"'*) break ;; esac
    tip=""; sleep 5
  done
  [ -n "$tip" ] || die "timed out reading the chain tip from $source/db"
  python3 -c "
import json,sys
t = json.load(sys.stdin)
print(t['slot'], t['hash'], t['block'])" <<<"$tip"
}

# Is this run's clock in stamp-file mode (changeable while it runs) or baked
# into FAKETIME at process start (needs a restart)?
stamp_mode() {
  grep -q '^FAKETIME_TIMESTAMP_FILE=' "$1/chain/faketime.env" 2>/dev/null
}

# Set a RUNNING (or stopped) run's clock to a given slot. A stamp write is
# absolute, not an increment: it re-anchors the speed-up at the moment the node
# reads the file, so the value written is "the clock is this, now".
write_stamp() {
  local run=$1 slot=$2 rate=$3
  python3 -c "$(genesis_py)
import sys
spec = f'@{slot_to_time($slot):%Y-%m-%d %H:%M:%S}'
if '$rate' not in ('', '1'): spec += ' x$rate'
open(sys.argv[2] + '/chain/faketime.stamp', 'w').write(spec + chr(10))
print(spec)" "$run/chain/shelley-genesis.json" "$run"
}

# Move a RUNNING fork to a new clock rate. A rate change is a stamp write at the
# CURRENT tip with the new multiplier; the cadence gate has to move with it or
# the chain would run at the wrong blocks/s. BLOCK_EVERY is read at node start,
# so it takes effect next start. Callers write the manifest first, on purpose: an
# interruption should leave the run claiming what it is about to become rather
# than silently disagreeing with its own files.
change_rate() {
  local run=$1 tip=$2 rate=$3 be=$4
  require_stamp_mode "$run" "$rate"
  if grep -q '^CARDANO_FORK_BLOCK_EVERY=' "$run/chain/fork.env"; then
    sed -i "s/^CARDANO_FORK_BLOCK_EVERY=.*/CARDANO_FORK_BLOCK_EVERY=$be/" "$run/chain/fork.env"
  fi
  scale_mempool "$run" "$rate"
  echo "clock -> $(write_stamp "$run" "$tip" "$rate")"
  echo "note: BLOCK_EVERY=$be and the mempool timeouts are read at node start, so"
  echo "      the clock changes now and the cadence on the next start"
}

# A clock baked into FAKETIME at process start cannot be moved while the node
# runs, so refuse before anything is written rather than half-way through.
require_stamp_mode() {
  local run=$1 rate=$2
  stamp_mode "$run" && return 0
  die "the fork at $run has its clock baked into FAKETIME, so the rate cannot be
  changed while it runs. Recreate it with a current 'devnet fork create' (which
  uses stamp-file mode), or stop it, run
    set-faketime $run --slot <its last forged slot> --rate $rate --fake-monotonic --stamp
  and start it again."
}

# The forger's own faked clock, as a slot. Its last 'Chain extended' line is a
# fair proxy because a forger emits one every BLOCK_EVERY slots -- this is NOT a
# general way to read any node's clock (a quiet node's last line is stale, and a
# child process re-anchors the multiplier and reports the bare anchor).
forger_clock_slot() {
  local run=$1 line ts
  line=$(docker logs "$(container_for "$run")" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' \
         | grep -a 'Chain extended' | tail -1)
  ts=$(echo "$line" | grep -oE '^\[[0-9-]+ [0-9:.]+Z\]' | tr -d '[]Z')
  [ -n "$ts" ] || return 1
  python3 -c "$(genesis_py)
import datetime
c = datetime.datetime.strptime('$ts'.strip(), '%Y-%m-%d %H:%M:%S.%f').replace(tzinfo=datetime.timezone.utc)
print(int((c - START).total_seconds() / SLOT_LEN))" "$run/chain/shelley-genesis.json"
}

# The live tip slot, asked of the node rather than read from its log.
live_tip_slot() {
  "$SCRIPTS/isolated-node" cli --run "$2" latest query tip --testnet-magic "$1" 2>/dev/null \
    | python3 -c "import json,sys
try: print(json.load(sys.stdin)['slot'])
except Exception: pass"
}

# ---------------------------------------------------------------- create

cmd_create() {
  local name="" network="" from="" slot="" rate=1 block_every=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name=${2:?}; shift 2 ;;
      --network) network=${2:?}; shift 2 ;;
      --from) from=${2:?}; shift 2 ;;
      --slot) slot=${2:?}; shift 2 ;;
      --rate) rate=${2:?}; shift 2 ;;
      --block-every) block_every=${2:?}; shift 2 ;;
      *) die "create: unknown argument $1" ;;
    esac
  done
  [ -n "$name" ] || die "create: --name is required"
  [ -n "$network" ] || die "create: --network is required"
  [ -n "$from" ] || die "create: --from is required (db:<path> or mithril)"
  case "$network" in preview|preprod|mainnet) ;; *) die "create: unknown network $network" ;; esac

  local run; run=$(resolve_run "$name")
  [ -e "$run" ] && die "$run already exists (run directories are never reused)"

  # --- source chain
  local source mithril_digest=""
  case "$from" in
    db:*) source=$(realpath "${from#db:}") ;;
    mithril)
      die "create --from mithril: mithril-client is not on PATH and this script
  will not download a chain implicitly. Fetch the snapshot yourself, then use
  --from db:<path>. The recorded invocation for this host is in
  \$GOLDEN_DB/mithril/download.log (mithril-client CLI 0.13.9)."
      ;;
    *) die "create: --from must be db:<path> or mithril" ;;
  esac
  [ -d "$source/db" ] || die "$source/db not found (a source dir holds db/, config/, pool/, god/)"
  [ -d "$source/config" ] || die "$source/config not found"
  [ -f "$source/mithril/download.log" ] && \
    mithril_digest=$(grep -oE "snapshot '[0-9a-f]{64}'" "$source/mithril/download.log" \
                     | head -1 | grep -oE '[0-9a-f]{64}' || true)

  # --- identity: reuse the source's god key and pool, generate if absent
  ensure_identity "$source"

  # --- fork slot: default to the source's own chain tip, volatile blocks
  # included. Not the ImmutableDB tip: the last ~k blocks of a synced chain
  # are still volatile, and gating below them would leave real blocks above
  # the fork slot, where fork mode rejects them -- silently discarding the
  # most recent stretch of the chain, which is usually the part worth forking.
  local fork_hash="" fork_block=""
  if [ -z "$slot" ]; then
    echo "reading $source/db's chain tip (throwaway clone, gates unset)..."
    local probed; probed=$(chaindb_tip "$source" "$(network_magic "$network")")
    [ -n "$probed" ] || die "could not read a tip from $source/db; pass --slot"
    read -r slot fork_hash fork_block <<<"$probed"
    echo "fork slot defaults to the chain tip: $slot (block $fork_block, $fork_hash)"
  fi

  [ -n "$block_every" ] || block_every=$(block_every_for_rate "$rate")

  # --- the opcert must be issued at the KES period of the FAKED clock, which
  # is anchored just past the fork slot. Compute that instant for FORK_NOW.
  local fork_now
  fork_now=$(python3 -c "$(genesis_py)
print(f'{slot_to_time($slot + 10):%Y-%m-%dT%H:%M:%SZ}')" "$source/config/shelley-genesis.json")

  echo "building run directory (reflink clone of $source/db)..."
  FORK_NOW=$fork_now GOLDEN_DB=$source RUNS_DIR=$RUNS CARDANO_CLI_BIN=$CLI \
    "$SCRIPTS/new-isolated-run" "$name" "$slot" "$block_every"

  # --- an explicit --slot behind the ImmutableDB tip is a real truncation:
  # db-truncater rewrites the ImmutableDB, and everything volatile is above
  # the fork slot by definition, so it goes too.
  #
  # A fork slot inside the volatile range needs no truncation. The gate does
  # the work: blocks above it have other issuers, fork mode rejects them, and
  # the node selects up to the fork slot and forges on from there. They stay
  # on disk as dead weight until the next reset.
  local imm; imm=$(probe_immutable_tip "$run/db" "$run/chain/config.json")
  local imm_slot=${imm%% *}
  if [ "$slot" -lt "$imm_slot" ]; then
    echo "truncating ImmutableDB from $imm_slot to the fork slot $slot..."
    "$TOOLBIN/db-truncater" --db "$run/db" --truncate-after-slot "$slot" \
      --config "$run/chain/config.json"
    rm -rf "${run:?}/db/volatile"
    drop_late_snapshots "$run/db" "$slot"
    fork_hash=$(probe_immutable_tip "$run/db" "$run/chain/config.json"); fork_hash=${fork_hash##* }
  elif [ "$slot" -gt "$imm_slot" ]; then
    echo "fork slot $slot is in the volatile range (ImmutableDB tip $imm_slot);"
    echo "  no truncation -- the gate rejects the real blocks above it."
  fi

  apply_rate "$run" "$rate" "$slot"
  write_manifest "$run" "$name" "$network" "$source" "$slot" "$fork_hash" \
                 "$rate" "$block_every" "$mithril_digest"

  echo
  echo "fork '$name' created: $run"
  echo "  manifest: $run/manifest.json"
  echo "  seeds:    not extracted (needs a running node: devnet fork start $name && devnet fork seeds $name)"
  echo "  start it: devnet fork start $name"
}

# A fork's identity lives in the source dir, the same contract
# /mnt/cardano/preview already follows: god/{god.skey,god.vkey} and
# pool/{cold,kes,vrf}.*. Generate only what is missing.
ensure_identity() {
  local source=$1
  if [ ! -f "$source/god/god.vkey" ]; then
    echo "generating god key in $source/god (source dir had none)"
    mkdir -p "$source/god"
    $CLI latest address key-gen \
      --verification-key-file "$source/god/god.vkey" \
      --signing-key-file "$source/god/god.skey"
  fi
  mkdir -p "$source/pool"
  if [ ! -f "$source/pool/cold.vkey" ]; then
    echo "generating fork pool cold key in $source/pool"
    $CLI latest node key-gen \
      --cold-verification-key-file "$source/pool/cold.vkey" \
      --cold-signing-key-file "$source/pool/cold.skey" \
      --operational-certificate-issue-counter-file "$source/pool/opcert.counter"
  fi
  if [ ! -f "$source/pool/kes.vkey" ]; then
    echo "generating fork pool KES key in $source/pool"
    $CLI latest node key-gen-KES \
      --verification-key-file "$source/pool/kes.vkey" \
      --signing-key-file "$source/pool/kes.skey"
  fi
  if [ ! -f "$source/pool/vrf.vkey" ]; then
    echo "generating fork pool VRF key in $source/pool"
    $CLI latest node key-gen-VRF \
      --verification-key-file "$source/pool/vrf.vkey" \
      --signing-key-file "$source/pool/vrf.skey"
    chmod 600 "$source/pool/vrf.skey"
  fi
}

# A ledger snapshot taken after the fork slot is state the truncated chain no
# longer leads to; leaving it would let the node resume past its own tip.
drop_late_snapshots() {
  local db=$1 slot=$2 s
  for s in $(ls -1 "$db/ledger" 2>/dev/null | grep -E '^[0-9]+$' || true); do
    if [ "$s" -gt "$slot" ]; then
      echo "  dropping ledger snapshot $s (after the fork slot)"
      rm -rf "${db:?}/ledger/$s"
    fi
  done
}

# Write the run's clock and the rate-scaled mempool timeouts. Arm 2 always:
# CLOCK_MONOTONIC is faked along with the wall clock.
apply_rate() {
  local run=$1 rate=$2 slot=$3
  # --stamp: the clock spec goes in a file the node re-reads, so `warp` can move
  # it without a restart and a follower can be synchronised after it is up.
  local args=("$run" --slot "$slot" --fake-monotonic --stamp)
  [ "$rate" != "1" ] && args+=(--rate "$rate")
  "$SCRIPTS/set-faketime" "${args[@]}"
  scale_mempool "$run" "$rate"
}

# Mempool admission timeouts are wall-clock seconds measured on the node's own
# (accelerated) clock, so at x100 the stock values expire before a transaction can
# be admitted at all and every submission fails MempoolTxTooSlow
# (fork-mode-rate-and-epoch.md 9c). They live in config.json, which the node reads
# at start -- so like CARDANO_FORK_BLOCK_EVERY, a change here lands on the next
# start, and writing it keeps the run's files agreeing with its claimed rate.
scale_mempool() {
  local run=$1 rate=$2
  python3 -c "
import json, sys
run, rate = sys.argv[1], float(sys.argv[2])
p = run + '/chain/config.json'
c = json.load(open(p))
def scale(v):
    x = v * rate
    return int(x) if x == int(x) else x
c['MempoolTimeoutSoft'] = scale($MEMPOOL_SOFT)
c['MempoolTimeoutHard'] = scale($MEMPOOL_HARD)
c['MempoolTimeoutCapacity'] = scale($MEMPOOL_CAPACITY)
json.dump(c, open(p, 'w'), indent=2)
print(f\"mempool timeouts scaled by x{rate:g}: \"
      f\"soft={c['MempoolTimeoutSoft']} hard={c['MempoolTimeoutHard']} \"
      f\"capacity={c['MempoolTimeoutCapacity']}\")
" "$run" "$rate"
}

write_manifest() {
  local run=$1 name=$2 network=$3 source=$4 slot=$5 hash=$6 rate=$7 be=$8 mithril=$9
  local addr kes
  addr=$($CLI latest address build \
           --payment-verification-key-file "$source/god/god.vkey" \
           --testnet-magic "$(network_magic "$network")" 2>/dev/null || true)
  # the opcert was issued at the KES period of the faked clock, which
  # new-isolated-run was pointed at via FORK_NOW = fork slot + the 10s lead
  kes=$(python3 -c "$(genesis_py)
print(kes_of($slot + 10))" "$run/chain/shelley-genesis.json")

  M_NAME=$name M_NETWORK=$network M_MAGIC=$(network_magic "$network") \
  M_SLOT=$slot M_HASH=$hash \
  M_GOD=$(sed -n 's/^CARDANO_FORK_GOD_KEY=//p' "$run/chain/fork.env") \
  M_POOL=$(sed -n 's/^CARDANO_FORK_POOL_ID=//p' "$run/chain/fork.env") \
  M_ADDR=$addr M_KES=$kes M_RATE=$rate M_BE=$be M_IMAGE=$IMAGE \
  M_GODKEY=$source/god/god.skey \
  M_DIGEST=$(docker image inspect "$IMAGE" --format '{{index .RepoDigests 0}}' 2>/dev/null | sed 's/.*@//' || true) \
  M_MITHRIL=$mithril \
  write_manifest_env "$run"
}

network_magic() {
  case "$1" in
    preview) echo 2 ;;
    preprod) echo 1 ;;
    mainnet) echo 764824073 ;;
    *) echo 2 ;;
  esac
}

# ---------------------------------------------------------------- adopt

cmd_adopt() {
  local target=${1:?usage: devnet fork adopt <run>}
  local run; run=$(resolve_run "$target")
  [ -d "$run/chain" ] || die "$run is not a run directory"
  [ -f "$run/manifest.json" ] && die "$run already has a manifest"
  [ -f "$run/chain/fork.env" ] || die "$run has no chain/fork.env -- not a fork (gates unset)"

  local name; name=$(basename "$run"); name=${name#run-}
  local slot; slot=$(sed -n 's/^CARDANO_FORK_SLOT=//p' "$run/chain/fork.env")
  # absent on a follower, which carries the gates but must not forge
  local be; be=$(sed -n 's/^CARDANO_FORK_BLOCK_EVERY=//p' "$run/chain/fork.env")
  local role=producer
  grep -q '"localRoots": \[\]' "$run/chain/topology.json" 2>/dev/null || role=follower
  [ "$role" = follower ] && be=""

  # The hash AT the fork slot is not recoverable from a run that has already
  # forged past it: db-analyser can only resume from an on-disk ledger
  # snapshot, and those are all post-fork by then. Leave it null rather than
  # record the current tip's hash, which is a different block.
  local hash=""

  local rate=1 anchor="" ft=""
  if [ -f "$run/chain/faketime.stamp" ]; then
    # stamp-file mode: the spec is the stamp, not a FAKETIME= line
    ft=$(cat "$run/chain/faketime.stamp")
  elif [ -f "$run/chain/faketime.env" ]; then
    ft=$(sed -n 's/^FAKETIME=//p' "$run/chain/faketime.env")
  fi
  if [ -n "$ft" ]; then
    anchor=${ft%% x*}
    case "$ft" in *' x'*) rate=${ft##* x} ;; esac
  else
    "$SCRIPTS/set-faketime" "$run" --slot "$slot" --fake-monotonic --stamp >/dev/null
    echo "no clock config: wrote one anchored at the fork slot (Arm 2, x1, stamp mode)"
  fi

  local network; network=$(guess_network "$run/chain/shelley-genesis.json")
  local kes; kes=$(python3 -c "$(genesis_py)
print(kes_of($slot))" "$run/chain/shelley-genesis.json")

  # the god address is derivable only if the source dir that made this run is
  # still around; it is not required to follow, so an absence is not an error
  local addr=""
  local gv=${GOLDEN_DB:-/mnt/cardano/preview}/god/god.vkey
  [ -f "$gv" ] && addr=$($CLI latest address build --payment-verification-key-file "$gv" \
                           --testnet-magic "$(network_magic "$network")" 2>/dev/null || true)

  M_NAME=$name M_NETWORK=$network M_MAGIC=$(network_magic "$network") \
  M_SLOT=$slot M_HASH=$hash M_GOD=$(sed -n 's/^CARDANO_FORK_GOD_KEY=//p' "$run/chain/fork.env") \
  M_POOL=$(sed -n 's/^CARDANO_FORK_POOL_ID=//p' "$run/chain/fork.env") \
  M_ADDR=$addr M_KES=$kes M_RATE=$rate M_BE=$be M_ROLE=$role M_IMAGE=$IMAGE \
  M_GODKEY=$(dirname "$gv")/god.skey \
  M_DIGEST=$(docker image inspect "$IMAGE" --format '{{index .RepoDigests 0}}' 2>/dev/null | sed 's/.*@//' || true) \
  M_MITHRIL="" \
  write_manifest_env "$run"
  echo "adopted $run as fork '$name'"
}

guess_network() {
  python3 -c "
import json,sys
g=json.load(open(sys.argv[1]))
print({2:'preview',1:'preprod',764824073:'mainnet'}.get(g.get('networkMagic'),'preview'))
" "$1"
}

# write_manifest builds its environment inline; adopt supplies it directly.
write_manifest_env() {
  local run=$1
  python3 -c "$(genesis_py)
import json, os
run = sys.argv[2]
faketime = {}
if os.path.exists(run + '/chain/faketime.env'):
    for line in open(run + '/chain/faketime.env'):
        if '=' in line:
            k, v = line.rstrip('\n').split('=', 1)
            faketime[k] = v
# in stamp-file mode the spec lives in faketime.stamp, not in faketime.env
stampf = run + '/chain/faketime.stamp'
if os.path.exists(stampf):
    ft = open(stampf).read().strip()
else:
    ft = faketime.get('FAKETIME', '')
anchor, _, _r = ft.partition(' x')
slot = int(os.environ['M_SLOT'])
m = {
  'manifestVersion': 1,
  'name': os.environ['M_NAME'],
  'network': os.environ['M_NETWORK'],
  'networkMagic': int(os.environ['M_MAGIC']),
  'genesis': {
    'systemStart': START.strftime('%Y-%m-%dT%H:%M:%SZ'),
    'slotLength': SLOT_LEN, 'epochLength': EPOCH_LEN,
    'slotsPerKESPeriod': KES_SLOTS, 'maxKESEvolutions': KES_MAX,
    'securityParam': json.load(open(sys.argv[1]))['securityParam'],
  },
  'fork': {
    'slot': slot, 'hash': os.environ['M_HASH'] or None, 'epoch': epoch_of(slot),
    'time': slot_to_time(slot).strftime('%Y-%m-%dT%H:%M:%SZ'),
  },
  'godKeyHash': os.environ['M_GOD'],
  # Where the signing key for that hash lives. The key is deliberately NOT
  # copied into the run: a run directory is disposable and gets cloned, the
  # identity is not. A client that cannot read this path cannot sign for the
  # fork, which is the correct failure.
  'godKeyPath': os.environ.get('M_GODKEY') or None,
  'producer': {
    'poolId': os.environ['M_POOL'],
    'address': os.environ['M_ADDR'] or None,
    'opcertKesPeriod': int(os.environ['M_KES']),
    'kesPeriodsValid': KES_MAX,
  },
  'clock': {
    'anchor': anchor, 'rate': float(os.environ['M_RATE']),
    'fakeMonotonic': faketime.get('FAKETIME_DONT_FAKE_MONOTONIC') == '0',
    'anchorSlot': slot,
    # 'stamp' can be changed while the node runs; 'env' needs a restart
    'mode': 'stamp' if os.path.exists(stampf) else 'env',
  },
  # null on a follower: it carries the fork gates so it accepts the forged
  # blocks, but must not have the cadence or it would forge too
  'blockEvery': int(os.environ['M_BE']) if os.environ['M_BE'] else None,
  'role': os.environ.get('M_ROLE', 'producer'),
  'image': os.environ['M_IMAGE'],
  'imageDigest': os.environ['M_DIGEST'] or None,
  'mithrilSnapshotDigest': os.environ['M_MITHRIL'] or None,
  'ccScriptsDirHash': None,
  'seeds': None,
  'createdAt': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
}
json.dump(m, open(run + '/manifest.json', 'w'), indent=2)
print('wrote ' + run + '/manifest.json')
" "$run/chain/shelley-genesis.json" "$run"
}

# ---------------------------------------------------------------- start

cmd_start() {
  local name=${1:?usage: devnet fork start <n> [--rate R]}; shift || true
  local rate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --rate) rate=${2:?}; shift 2 ;;
      *) die "start: unknown argument $1" ;;
    esac
  done
  local run; run=$(resolve_run "$name")
  local m; m=$(require_manifest "$name")

  fork_running "$run" && die "fork '$name' is already running"

  check_memory "$(mget "$m" network)" "start"

  # A rate change rewrites the clock, the cadence and the mempool timeouts.
  if [ -n "$rate" ] && [ "$(rate_str "$rate")" != "$(rate_str "$(mget "$m" clock.rate)")" ]; then
    rate=$(rate_str "$rate")
    local be; be=$(block_every_for_rate "$rate")
    echo "rate x$rate: blockEvery $be, mempool timeouts x$rate"
    # Manifest first: this mutates three files, and an interruption part-way
    # used to leave the run configured one way and claiming another.
    python3 -c "
import json,sys
m=json.load(open(sys.argv[1])); m['clock']['rate']=float(sys.argv[2]); m['blockEvery']=int(sys.argv[3])
json.dump(m,open(sys.argv[1],'w'),indent=2)" "$m" "$rate" "$be"
    if grep -q '^CARDANO_FORK_BLOCK_EVERY=' "$run/chain/fork.env"; then
      sed -i "s/^CARDANO_FORK_BLOCK_EVERY=.*/CARDANO_FORK_BLOCK_EVERY=$be/" "$run/chain/fork.env"
    else
      echo "CARDANO_FORK_BLOCK_EVERY=$be" >> "$run/chain/fork.env"
    fi
    apply_rate "$run" "$rate" "$(last_slot "$run")"
    python3 -c "
import json,sys
m=json.load(open(sys.argv[1]))
ft=dict(l.rstrip(chr(10)).split('=',1) for l in open(sys.argv[2]) if '=' in l)
st=sys.argv[3]
import os
if os.path.exists(st): m['clock']['anchor']=open(st).read().strip().split(' x')[0]
else: m['clock']['anchor']=ft.get('FAKETIME','').split(' x')[0]
json.dump(m,open(sys.argv[1],'w'),indent=2)" "$m" "$run/chain/faketime.env" "$run/chain/faketime.stamp"
  fi

  check_kes "$run" "$m"
  "$SCRIPTS/isolated-node" start "$run"
}

# The opcert is valid for [issued, issued + maxKESEvolutions). The node checks
# that against its OWN clock, which is the faked one.
check_kes() {
  local run=$1 m=$2
  python3 -c "$(genesis_py)
import datetime, json, os
m = json.load(open(sys.argv[2]))
# stamp-file mode keeps the spec in faketime.stamp; env mode in FAKETIME=
if os.path.exists(sys.argv[4]):
    spec = open(sys.argv[4]).read().strip()
else:
    ft = dict(l.rstrip(chr(10)).split('=',1) for l in open(sys.argv[3]) if '=' in l)
    spec = ft.get('FAKETIME','')
anchor = spec.split(' x')[0].lstrip('@')
if not anchor:
    raise SystemExit('devnet fork: no clock configured for this run '
                     '(neither chain/faketime.stamp nor FAKETIME= in chain/faketime.env)')
now = datetime.datetime.strptime(anchor, '%Y-%m-%d %H:%M:%S').replace(tzinfo=datetime.timezone.utc)
slot = int((now - START).total_seconds() / SLOT_LEN)
period = kes_of(slot)
issued = m['producer']['opcertKesPeriod']
if not (issued <= period < issued + KES_MAX):
    raise SystemExit(
      f\"devnet fork: opcert KES period {issued} does not cover the faked clock \"
      f\"(period {period}, slot {slot}).\n\"
      f\"  Valid periods: {issued}..{issued + KES_MAX - 1}.\n\"
      f\"  Reissue with FORK_NOW at the target instant, or warp less far.\")
print(f'KES: opcert period {issued}, faked clock in period {period}, '
      f'{issued + KES_MAX - period} of {KES_MAX} periods remaining -- ok')
" "$run/chain/shelley-genesis.json" "$m" "$run/chain/faketime.env" "$run/chain/faketime.stamp"
}

# The run's own last forged slot: its container log if it is the one that ran,
# else the fork slot from the manifest.
last_slot() {
  local run=$1 s="" c; c=$(container_for "$run")
  if docker inspect "$c" >/dev/null 2>&1; then
    s=$(docker logs "$c" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' \
        | grep -a 'Chain extended' | tail -1 | grep -oE 'at slot [0-9]+' | grep -oE '[0-9]+' || true)
  fi
  [ -n "$s" ] || s=$(mget "$run/manifest.json" fork.slot)
  echo "$s"
}

# ---------------------------------------------------------------- stop/status

cmd_stop() {
  local run
  if [ $# -gt 0 ]; then
    run=$(resolve_run "$1")
  else
    local dirs; dirs=$(running_fork_dirs)
    case "$(echo "$dirs" | grep -c .)" in
      1) run=$dirs ;;
      0) echo "no fork producer running"; return 0 ;;
      *) die "several forks are running; name one:
$(echo "$dirs" | sed 's/^/  /')" ;;
    esac
  fi
  # The sidecar is restart: on-failure and talks to the node's socket, so leaving
  # it behind a stopped node means an endless restart loop against a dead socket.
  local oc; oc=$(ogmios_container_for "$run")
  if docker inspect "$oc" >/dev/null 2>&1; then
    docker rm -f "$oc" >/dev/null
    echo "removed the ogmios sidecar $oc"
  fi

  # the follower lives in the producer's network namespace, so it goes first
  local frun=$run-follower
  if [ -d "$frun" ] && docker inspect -f '{{.State.Running}}' "$(container_for "$frun")" 2>/dev/null | grep -qx true; then
    "$SCRIPTS/follower-node" stop "$frun"
  fi
  fork_running "$run" || { echo "fork at $run is not running"; return 0; }
  "$SCRIPTS/isolated-node" stop "$run"
}

cmd_status() {
  local run m
  if [ $# -gt 0 ]; then run=$(resolve_run "$1"); else
    local dirs; dirs=$(running_fork_dirs)
    case "$(echo "$dirs" | grep -c .)" in
      1) run=$dirs ;;
      0) die "no fork producer running; name one: devnet fork status <n>" ;;
      *) die "several forks are running; name one:
$(echo "$dirs" | sed 's/^/  /')" ;;
    esac
  fi
  m=$run/manifest.json
  [ -f "$m" ] || die "no manifest at $m -- run 'devnet fork adopt $(basename "$run")'"

  local state="stopped"
  fork_running "$run" && state="running"

  local tip_json=""
  if [ "$state" = running ]; then
    tip_json=$("$SCRIPTS/isolated-node" cli --run "$run" latest query tip \
                 --testnet-magic "$(mget "$m" networkMagic)" 2>/dev/null || true)
  fi

  STATUS_STATE=$state STATUS_TIP=$tip_json python3 -c "$(genesis_py)
import datetime, json, os
m = json.load(open(sys.argv[2]))
tip = json.loads(os.environ['STATUS_TIP']) if os.environ.get('STATUS_TIP') else None
rate = m['clock']['rate']
anchor = m['clock']['anchor'].lstrip('@')
print(f\"fork        {m['name']}  ({m['network']}, magic {m['networkMagic']})\")
print(f\"state       {os.environ['STATUS_STATE']}\")
h = m['fork']['hash']
print(f\"fork point  slot {m['fork']['slot']}  epoch {m['fork']['epoch']}  \"
      f\"{h[:16] + '...' if h else '(hash not recorded)'}\")
print(f\"role        {m.get('role','producer')}\")
seeds = m.get('seeds') or []
print(f\"seeds       {', '.join(s['role'] for s in seeds) if seeds else '(none -- devnet fork seeds ' + m['name'] + ')'}\")
print(f\"rate        x{rate:g}   blockEvery {m['blockEvery'] or '- (not forging)'}   \"
      f\"{'CLOCK_MONOTONIC faked (Arm 2)' if m['clock']['fakeMonotonic'] else 'Arm 1 -- WRONG ARM'}\")
print(f\"clock       anchored at {anchor}\")
if tip:
    slot = tip['slot']
    print(f\"tip         slot {slot}  block {tip['block']}  epoch {tip['epoch']}  \"
          f\"{tip['era']}  {tip.get('syncProgress','?')}%\")
    print(f\"faked now   {slot_to_time(slot):%Y-%m-%d %H:%M:%S} UTC (slot {slot})\")
    print(f\"since fork  {slot - m['fork']['slot']} slots\")
    period = kes_of(slot)
    issued = m['producer']['opcertKesPeriod']
    print(f\"KES         period {period}, opcert issued {issued}, \"
          f\"{issued + KES_MAX - period} of {KES_MAX} remaining\")
else:
    print('tip         (not running -- start it to query the tip)')
" "$run/chain/shelley-genesis.json" "$m"
}

# ---------------------------------------------------------------- warp

# Warp does NOT skip the tip ahead. The ledger can only forecast ~3k/f slots
# past its tip, so a clock planted beyond that fails leadership checks
# (NoLedgerView / CurrentSlotUnknown), and whether a node absorbs a forward
# clock jump at all is untested -- see fork-mode-clock-signal.md 10d. So the
# chain forges through the distance at its cadence, and the cost of a warp is
# real time: (target - tip) / rate seconds. Raising the rate is the way to make
# a warp cheaper.
cmd_warp() {
  local name=${1:?usage: devnet fork warp <n> --to-slot S | --to-epoch E [--rate R]}; shift || true
  local to_slot="" to_epoch="" rate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to-slot)  to_slot=${2:?}; shift 2 ;;
      --to-epoch) to_epoch=${2:?}; shift 2 ;;
      --rate)     rate=${2:?}; shift 2 ;;
      *) die "warp: unknown argument $1" ;;
    esac
  done
  local run; run=$(resolve_run "$name")
  local m; m=$(require_manifest "$name")
  [ -n "$to_slot$to_epoch" ] || die "warp: one of --to-slot or --to-epoch is required"
  [ -n "$to_slot" ] && [ -n "$to_epoch" ] && die "warp: --to-slot and --to-epoch are exclusive"

  local magic; magic=$(mget "$m" networkMagic)
  fork_running "$run" || die "fork '$name' is not running.
  A warp needs the chain to advance through the distance, so start it first:
    devnet fork start $name"

  local tip; tip=$(live_tip_slot "$magic" "$run")
  [ -n "$tip" ] || die "could not read the tip from the running node"

  local target
  if [ -n "$to_epoch" ]; then
    target=$(python3 -c "import json,sys; print(int(sys.argv[2]) * json.load(open(sys.argv[1]))['epochLength'])" \
               "$run/chain/shelley-genesis.json" "$to_epoch")
  else
    target=$to_slot
  fi
  [ "$target" -gt "$tip" ] || die "warp: refusing to go backwards (tip $tip, target $target).
  A fork can only move forward; use 'devnet fork reset $name' to return to the fork point."

  local old_rate; old_rate=$(rate_str "$(mget "$m" clock.rate)")
  [ -n "$rate" ] || rate=$old_rate
  rate=$(rate_str "$rate")
  local be; be=$(block_every_for_rate "$rate")

  # KES first: the opcert is checked against the node's own (faked) clock, and
  # reissuing it needs a restart, so refuse before changing anything.
  python3 - "$run/chain/shelley-genesis.json" "$m" "$target" <<'KESPY'
import json, sys
g = json.load(open(sys.argv[1]))
m = json.load(open(sys.argv[2]))
target = int(sys.argv[3])
kes_max = g['maxKESEvolutions']
period = target // g['slotsPerKESPeriod']
issued = m['producer']['opcertKesPeriod']
if not (issued <= period < issued + kes_max):
    sys.exit(
        "devnet fork: warp target slot %d is in KES period %d, outside the "
        "opcert's %d..%d.\n"
        "  Reissuing the opcert needs a restart; warp less far, or recreate the run."
        % (target, period, issued, issued + kes_max - 1))
print("KES: target period %d, opcert covers %d..%d -- ok"
      % (period, issued, issued + kes_max - 1))
KESPY

  python3 - "$run/chain/shelley-genesis.json" "$tip" "$target" "$rate" <<'PLANPY'
import json, sys
g = json.load(open(sys.argv[1]))
tip, target, rate = int(sys.argv[2]), int(sys.argv[3]), float(sys.argv[4])
el = g['epochLength']
print("warp  slot %d -> %d   epoch %d -> %d" % (tip, target, tip // el, target // el))
print("      %d slots at x%g = %.0f real seconds" % (target - tip, rate, (target - tip) / rate))
print("      the chain forges through this; the clock cannot skip past its own tip")
PLANPY

  # Manifest FIRST, so an interruption leaves the run claiming what it is about
  # to become rather than silently disagreeing with its own files.
  python3 -c "
import json,sys
m=json.load(open(sys.argv[1])); m['clock']['rate']=float(sys.argv[2]); m['blockEvery']=int(sys.argv[3])
m['clock']['warpTarget']=int(sys.argv[4])
json.dump(m,open(sys.argv[1],'w'),indent=2)" "$m" "$rate" "$be" "$target"

  require_stamp_mode "$run" "$rate"

  # Only touch the clock if the rate actually changed. A needless stamp write
  # re-anchors the speed-up at the read, which can move the clock BACKWARDS
  # relative to where it had run to (fork-mode-clock-signal.md 10d).
  [ "$rate" != "$old_rate" ] && change_rate "$run" "$tip" "$rate" "$be"

  # Now wait for the chain to reach the target.
  local deadline=$(( SECONDS + ${WARP_TIMEOUT:-3600} ))
  local last=$tip
  while [ "$SECONDS" -lt "$deadline" ]; do
    tip=$(live_tip_slot "$magic" "$run")
    [ -n "$tip" ] || { sleep 5; continue; }
    [ "$tip" -ge "$target" ] && break
    if [ $(( tip - last )) -ge 2000 ]; then
      echo "  ... slot $tip  ($(( target - tip )) to go)"
      last=$tip
    fi
    sleep 5
  done
  [ "$tip" -ge "$target" ] || die "warp timed out at slot $tip (target $target).
  Raise WARP_TIMEOUT, or the rate."

  python3 - "$run/chain/shelley-genesis.json" "$tip" <<'ARRPY'
import json, sys
g = json.load(open(sys.argv[1]))
tip = int(sys.argv[2])
print("arrived  slot %d  epoch %d" % (tip, tip // g['epochLength']))
ARRPY
  python3 -c "
import json,sys
m=json.load(open(sys.argv[1])); m['clock'].pop('warpTarget',None)
json.dump(m,open(sys.argv[1],'w'),indent=2)" "$m"
}

# ---------------------------------------------------------------- rate

# The rate on its own, with no destination. `warp` changes the rate as a side
# effect of going somewhere, and `start --rate` needs a restart; this is the one
# that just changes how fast a running fork's clock runs.
cmd_rate() {
  local name=${1:?usage: devnet fork rate <n> <r>}
  local rate=${2:?usage: devnet fork rate <n> <r>}
  local run; run=$(resolve_run "$name")
  local m; m=$(require_manifest "$name")
  fork_running "$run" || die "fork '$name' is not running. A stopped fork takes its
  rate at start:
    devnet fork start $name --rate $rate"

  rate=$(rate_str "$rate")
  local old_rate; old_rate=$(rate_str "$(mget "$m" clock.rate)")
  if [ "$rate" = "$old_rate" ]; then
    echo "fork '$name' is already at x$rate; leaving the clock alone"
    return 0
  fi
  local be; be=$(block_every_for_rate "$rate")
  local tip; tip=$(live_tip_slot "$(mget "$m" networkMagic)" "$run")
  [ -n "$tip" ] || die "could not read the tip from the running node"

  # refuse before writing anything if this run's clock cannot move
  require_stamp_mode "$run" "$rate"
  echo "rate x$old_rate -> x$rate at slot $tip: blockEvery $be"
  python3 -c "
import json,sys
m=json.load(open(sys.argv[1])); m['clock']['rate']=float(sys.argv[2]); m['blockEvery']=int(sys.argv[3])
json.dump(m,open(sys.argv[1],'w'),indent=2)" "$m" "$rate" "$be"
  change_rate "$run" "$tip" "$rate" "$be"
}

# ---------------------------------------------------------------- seeds

# A fork inherits a real chain's UTxO set, but nothing hands you a funded
# address to test with -- unlike local devnet mode, there is no genesis wallet.
# Rather than scanning the whole UTxO set to find one (the kind of
# `query ledger-state` that has already cost this host its memory -- see
# fork-mode-sdk.md 11e), this checks a short, checked-in list of candidate
# addresses against the fork's own live ledger and records which are still
# funded. It verifies, it does not discover.
cmd_seeds() {
  local name=${1:?usage: devnet fork seeds <n> [--candidates <file>]}; shift || true
  local candidates=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --candidates) candidates=${2:?}; shift 2 ;;
      *) die "seeds: unknown argument $1" ;;
    esac
  done
  local run; run=$(resolve_run "$name")
  local m; m=$(require_manifest "$name")
  fork_running "$run" || die "fork '$name' is not running. Seeds are verified against
  the fork's own live ledger state:
    devnet fork start $name"

  local network; network=$(mget "$m" network)
  [ -n "$candidates" ] || candidates="$DEVNET_ROOT/config/fork-seed-candidates/$network.json"
  [ -f "$candidates" ] || die "seeds: no candidate file for network '$network'
  (looked at $candidates; pass --candidates <file> to use another)"
  local magic; magic=$(mget "$m" networkMagic)

  python3 -c "
import json, subprocess, sys

candidates_path, manifest_path, run, magic, isolated_node = sys.argv[1:6]
candidates = json.load(open(candidates_path))
seeds = []
for c in candidates:
    addr, role = c['address'], c.get('role', 'seed')
    out = subprocess.run(
        [isolated_node, 'cli', '--run', run, 'latest', 'query', 'utxo',
         '--address', addr, '--testnet-magic', magic, '--output-json'],
        capture_output=True, text=True)
    # cardano-cli's own JSON keeps a large lovelace figure as an exact integer
    # literal; Python's json module reads that as an arbitrary-precision int,
    # unlike JS's Number -- see fork-mode-sdk.md 11b for what happens when a
    # quantity like this instead goes through JSON.parse.
    utxos = json.loads(out.stdout or '{}') if out.returncode == 0 else {}
    if not utxos:
        print(f'  {role:<10} {addr}: no funds, skipping')
        continue
    txin, o = max(utxos.items(), key=lambda kv: kv[1]['value']['lovelace'])
    lovelace = o['value']['lovelace']
    # stringified on the way into manifest.json -- a bare JSON number here would
    # hit the exact same rounding once src/fork/cli.mjs's plain JSON.parse reads
    # it back on the JS side.
    seeds.append({'address': addr, 'role': role, 'utxo': txin, 'lovelace': str(lovelace)})
    print(f'  {role:<10} {addr}: funded, {txin} ({lovelace} lovelace)')

if not seeds:
    sys.exit(f'seeds: none of the {len(candidates)} candidate(s) are funded on this fork')

m = json.load(open(manifest_path))
m['seeds'] = seeds
json.dump(m, open(manifest_path, 'w'), indent=2)
print(f'{len(seeds)}/{len(candidates)} candidate(s) funded; written to {manifest_path}')
" "$candidates" "$m" "$run" "$magic" "$SCRIPTS/isolated-node"
}

# ---------------------------------------------------------------- reset

cmd_reset() {
  local name=${1:?usage: devnet fork reset <n>}
  local run; run=$(resolve_run "$name")
  local m; m=$(require_manifest "$name")
  fork_running "$run" && die "fork '$name' is running; stop it first"

  local fork_slot; fork_slot=$(mget "$m" fork.slot)
  local tip; tip=$(probe_immutable_tip "$run/db" "$run/chain/config.json")
  local tip_slot=${tip%% *}
  local be; be=$(mget "$m" blockEvery); [ -n "$be" ] || be=1
  local fork_blocks=$(( (tip_slot - fork_slot) / be ))

  echo "fork slot $fork_slot, ImmutableDB tip $tip_slot, ~$fork_blocks fork blocks (k=$SECURITY_PARAM)"
  if [ "$tip_slot" -le "$fork_slot" ]; then
    echo "no fork block has reached the ImmutableDB; dropping volatile/ only"
    rm -rf "${run:?}/db/volatile"
  else
    echo "a fork block is in the ImmutableDB; truncating to the fork slot"
    "$TOOLBIN/db-truncater" --db "$run/db" --truncate-after-slot "$fork_slot" \
      --config "$run/chain/config.json"
    rm -rf "${run:?}/db/volatile"
  fi
  drop_late_snapshots "$run/db" "$fork_slot"
  local rate; rate=$(rate_str "$(mget "$m" clock.rate)")
  local ftargs=("$run" --slot "$fork_slot" --fake-monotonic)
  [ "$rate" != "1" ] && ftargs+=(--rate "$rate")
  "$SCRIPTS/set-faketime" "${ftargs[@]}"
  echo "fork '$name' reset to slot $fork_slot"
}

# ---------------------------------------------------------------- list

cmd_list() {
  local busy; busy=$(running_fork_dirs)
  printf '%-14s %-9s %-11s %-6s %-8s %s\n' NAME STATE FORK-SLOT RATE BLOCK-EV MANIFEST
  local d
  for d in "$RUNS"/run-*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    local name; name=$(basename "$d"); name=${name#run-}
    local state="stopped"; echo "$busy" | grep -qx "$d" && state="running"
    if [ -f "$d/manifest.json" ]; then
      printf '%-14s %-9s %-11s %-6s %-8s %s\n' "$name" "$state" \
        "$(mget "$d/manifest.json" fork.slot)" \
        "x$(mget "$d/manifest.json" clock.rate)" \
        "$(mget "$d/manifest.json" blockEvery)" yes
    else
      local slot="-"
      [ -f "$d/chain/fork.env" ] && slot=$(sed -n 's/^CARDANO_FORK_SLOT=//p' "$d/chain/fork.env")
      printf '%-14s %-9s %-11s %-6s %-8s %s\n' "$name" "$state" "$slot" - - "no (adopt)"
    fi
  done
}

# ---------------------------------------------------------------- follow

cmd_follow() {
  local src=${1:?usage: devnet fork follow <manifest path>}
  case "$src" in
    http://*|https://*)
      die "follow <url>: a remote follower is not wired up yet.
  The follower joins the producer's own network namespace
  (scripts/follower-node, --network container:<the forger>), which is what keeps
  the phase-8 isolation property. Reaching a producer on another machine needs
  a published port and a way to obtain the pre-fork chain, neither of which
  exists today. Copy the manifest and the chain locally and follow that."
      ;;
  esac
  [ -f "$src" ] || die "no manifest at $src"

  local busy; busy=$(resolve_run "$(mget "$src" name)")
  fork_running "$busy" || die "fork '$(mget "$src" name)' is not running; the follower joins its network namespace"

  local name; name=$(mget "$src" name)
  local fname="$name-follower"
  local frun; frun=$(resolve_run "$fname")
  check_memory "$(mget "$src" network)" "follow"

  if [ ! -d "$frun" ]; then
    local source; source=$(dirname "$(dirname "$src")")
    echo "building follower run $frun from $(mget "$src" name)"
    FOLLOWER=1 FORK_NOW=$(python3 -c "$(genesis_py)
print(f'{slot_to_time($(mget "$src" fork.slot) + 10):%Y-%m-%dT%H:%M:%SZ}')" \
      "$busy/chain/shelley-genesis.json") \
      GOLDEN_DB=${GOLDEN_DB:-/mnt/cardano/preview} RUNS_DIR=$RUNS CARDANO_CLI_BIN=$CLI \
      "$SCRIPTS/new-isolated-run" "$fname" "$(mget "$src" fork.slot)"
  fi

  # The follower's clock is set AFTER it is up, from the forger's actual clock.
  # Guessing a lead before startup is a race: measured launch skew was 21.6 real
  # seconds, which at x100 is 2157 slots against a 400-slot lead, and a follower
  # whose clock sits behind the chain rejects every block it receives and thrashes
  # its one peer connection (fork-mode-clock-signal.md 10e).
  local rate; rate=$(rate_str "$(mget "$src" clock.rate)")
  local ftargs=("$frun" --slot "$(mget "$src" fork.slot)" --fake-monotonic --stamp)
  [ "$rate" != "1" ] && ftargs+=(--rate "$rate")
  "$SCRIPTS/set-faketime" "${ftargs[@]}" >/dev/null
  "$SCRIPTS/follower-node" start "$frun" --of "$busy"

  # Now synchronise. A stamp write is absolute and re-anchors at the read, so the
  # value to write is the forger's clock NOW plus headroom -- not an offset added
  # to wherever the follower had got to.
  local margin=${FOLLOWER_MARGIN_SLOTS:-600}
  local fc deadline=$(( SECONDS + 120 ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    fc=$(forger_clock_slot "$busy" 2>/dev/null || true)
    [ -n "$fc" ] && break
    sleep 3
  done
  [ -n "$fc" ] || die "could not read the forger's clock to synchronise the follower"
  echo "sync: forger clock at slot $fc, follower clock -> $(write_stamp "$frun" "$(( fc + margin ))" "$rate") (+$margin margin)"
  echo "      re-run 'devnet fork follow' to re-synchronise if it drifts"
}

# ---------------------------------------------------------------- ogmios

# One ogmios per fork, named after the fork's own container. It reaches the node
# over <run>/ipc/node.socket and publishes NOTHING: it sits on the shared
# devnet-forks bridge and is addressed there. The node keeps network_mode: none,
# so the phase-8 isolation property is untouched however many sidecars run.
ogmios_container_for() { echo "$(container_for "$1")-ogmios"; }

# The bridge is external to every fork's compose project (see docker-compose.yml),
# so somebody has to create it; that somebody is here.
ensure_forks_net() {
  docker network inspect "$FORKS_NET" >/dev/null 2>&1 || {
    echo "creating the $FORKS_NET bridge"
    docker network create "$FORKS_NET" >/dev/null
  }
}

# A sidecar's address on the bridge. The host can route to a bridge IP directly
# but cannot resolve a container name, so a client on the host asks docker for
# the name's address rather than DNS -- same addressing, different resolver.
ogmios_ip() {
  docker inspect "$1" --format \
    "{{with index .NetworkSettings.Networks \"$FORKS_NET\"}}{{.IPAddress}}{{end}}" 2>/dev/null
}

# Ogmios is up when it answers /health AND reports a connection to the node. Its
# own "networkSynchronization" is measured against the REAL clock, so on a fork it
# reads a little under 1 and drifts further as the golden DB ages (0.994 on a
# nine-day-old clone); that is cosmetic and not a readiness signal.
ogmios_wait() {
  local ip=$1 deadline=$(( SECONDS + ${OGMIOS_TIMEOUT:-120} ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if python3 -c "
import json, sys, urllib.request
try:
    h = json.load(urllib.request.urlopen('http://' + sys.argv[1] + ':1337/health', timeout=3))
except Exception:
    sys.exit(1)
sys.exit(0 if h.get('connectionStatus') == 'connected' else 1)
" "$ip" 2>/dev/null; then return 0; fi
    sleep 2
  done
  return 1
}

cmd_ogmios() {
  local action=${1:-status}; shift || true
  local run; run=$(resolve_running "${1:-}")
  local c; c=$(ogmios_container_for "$run")

  case "$action" in
    start)
      fork_running "$run" || die "the fork at $run is not running, and ogmios needs
  its socket. Start the fork first: devnet fork start <n>"
      ensure_forks_net
      export ISOLATED_RUN_DIR=$run FORK_OGMIOS_NAME=$c
      export MY_UID=${MY_UID:-$(id -u)} MY_GID=${MY_GID:-$(id -g)}
      # its own compose project, for the same reason the node has one: a second
      # fork must be an addition, not a replacement
      docker compose -p "$c" -f "$DEVNET_ROOT/docker-compose.yml" \
        --profile fork-sidecar up -d --force-recreate ogmios-fork
      local ip; ip=$(ogmios_ip "$c")
      [ -n "$ip" ] || die "ogmios started but has no address on $FORKS_NET"
      ogmios_wait "$ip" || die "ogmios at $ip:1337 never reported a node connection.
  Its log:
$(docker logs --tail 20 "$c" 2>&1 | sed 's/^/    /')"
      echo "ogmios ready: ws://$ip:1337  (container $c, nothing published)"
      ;;
    stop)
      docker inspect "$c" >/dev/null 2>&1 || { echo "no ogmios sidecar for $run"; return 0; }
      # removed, not stopped: unlike a fork run there is nothing in its log worth
      # keeping, and a stale container would hold the bridge address
      docker rm -f "$c" >/dev/null
      echo "removed $c"
      ;;
    url)
      local ip; ip=$(ogmios_ip "$c")
      [ -n "$ip" ] || die "no ogmios sidecar running for $run -- devnet fork ogmios start"
      echo "ws://$ip:1337"
      ;;
    status)
      if docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null | grep -qx true; then
        echo "ogmios      running  ws://$(ogmios_ip "$c"):1337  ($c)"
      else
        echo "ogmios      stopped  ($c)"
      fi
      ;;
    *) die "ogmios: unknown action '$action' (start|stop|status|url)" ;;
  esac
}

# ---------------------------------------------------------------- clock

# The forger's own faked clock, for a client that needs "now" on the fork. There
# is no cheap general source: a child process under libfaketime re-anchors the
# multiplier and reports the bare anchor, so the only honest observable is the
# forger's own log timestamps. Hence producer-only, and stale if it is quiet --
# which is why the JSON names its source rather than claiming to be the clock.
cmd_clock() {
  local run; run=$(resolve_running "${1:-}")
  local m; m=$(require_manifest "$run")
  fork_running "$run" || die "the fork at $run is not running; its clock is only
  observable while it forges"
  local slot
  slot=$(forger_clock_slot "$run") || die "no 'Chain extended' line in $(container_for "$run")'s
  log yet -- wait for the first forged block"
  CLOCK_SLOT=$slot python3 -c "$(genesis_py)
import json, os
m = json.load(open(sys.argv[2]))
slot = int(os.environ['CLOCK_SLOT'])
print(json.dumps({
  'slot': slot,
  'time': slot_to_time(slot).strftime('%Y-%m-%dT%H:%M:%SZ'),
  'epoch': epoch_of(slot),
  'rate': m['clock']['rate'],
  'kesPeriod': kes_of(slot),
  'source': 'forger-last-chain-extended',
}, indent=2))
" "$run/chain/shelley-genesis.json" "$m"
}

# ---------------------------------------------------------------- dispatch

cmd=${1:-}; shift || true
case "$cmd" in
  create) cmd_create "$@" ;;
  adopt)  cmd_adopt "$@" ;;
  start)  cmd_start "$@" ;;
  stop)   cmd_stop "$@" ;;
  status) cmd_status "$@" ;;
  warp)   cmd_warp "$@" ;;
  rate)   cmd_rate "$@" ;;
  seeds)  cmd_seeds "$@" ;;
  reset)  cmd_reset "$@" ;;
  list)   cmd_list "$@" ;;
  follow) cmd_follow "$@" ;;
  ogmios) cmd_ogmios "$@" ;;
  clock)  cmd_clock "$@" ;;
  ""|-h|--help|help) usage 0 ;;
  *) echo "devnet fork: unknown subcommand '$cmd'" >&2; usage ;;
esac
