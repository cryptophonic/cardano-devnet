#!/bin/bash

# Start (or stop) a second node that FOLLOWS the isolated forger, for testing
# that a peer adopts the forked chain -- crosses an epoch boundary in sync,
# say -- rather than just the forger's own view of it.
#
# Usage:
#   follower-node start <run dir> [--of <forger run dir>]
#   follower-node stop <run dir>
#   follower-node logs <run dir> [-f]
#   follower-node cli <run dir> <cardano-cli args...>  # against the FOLLOWER's socket
#
# Container names derive from the run directories, so several run pairs can run
# at once. --of defaults to the follower's run dir with a trailing "-follower"
# removed, which is what adafork's `devnet-fork follow` creates.
#
# Isolation is unchanged. The follower joins the FORGER'S OWN network
# namespace (--network container:...), the same way `isolated-node cli` does, so
# it reaches the forger at 127.0.0.1:3001 while the namespace still contains
# nothing but lo: no interface, no route, no published port, nothing for a real
# preview node to reach or be reached by. Running the follower on a bridge
# network instead would have given up exactly the property phase 8 established.
#
# The forger must already be running, so the follower always starts second. With
# an accelerated clock that used to be a race: libfaketime anchors a speed-up at
# PROCESS start, so at x100 one real second of launch skew is 100 slots of clock
# skew, and a follower whose clock sits BEHIND the chain rejects every block it
# receives. Measured launch skew was 21.6 real seconds -- 2157 slots at x100 --
# against a lead of 400, so padding it was never reliable.
#
# The fix is not a lead. Put the run's clock in stamp-file mode
# (set-faketime --stamp) and set it AFTER the follower is up, from the forger's
# actual clock plus a margin; adafork's `devnet-fork follow` does this. A stamp write
# re-anchors at the read, so the value to write is "the clock is X now", not an
# offset. See adafork's server/test/fixtures/fork-mode-clock-signal.md 10e.

set -euo pipefail

DEVNET_ROOT=${DEVNET_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}
IMAGE=${DEVNET_IMAGE:-ghcr.io/cryptophonic/cardano-node-ogmios:v7.0.0_11.1.3-forkmode-d462a8ea9}
container_for() { local b; b=$(basename "${1%/}"); echo "devnet-run-${b#run-}"; }
export MY_UID=${MY_UID:-$(id -u)}
export MY_GID=${MY_GID:-$(id -g)}

cmd=${1:-}; shift || true

case "$cmd" in
  start)
    rundir=${1:?usage: follower-node start <run dir> [--of <forger run dir>]}; shift
    rundir=$(realpath "$rundir")
    forgerdir=""
    [ "${1:-}" = "--of" ] && { forgerdir=$(realpath "$2"); shift 2; }
    NAME=$(container_for "$rundir")
    if [ -n "$forgerdir" ]; then
      FORGER=$(container_for "$forgerdir")
    else
      FORGER=$(container_for "$(basename "${rundir%-follower}")")
    fi
    echo "follower container: $NAME   forger: $FORGER"
    golden=$(realpath "${GOLDEN_DB:-/mnt/cardano/preview}" 2>/dev/null || true)
    if [ -n "$golden" ] && [ "$rundir" = "$golden" -o "$rundir/db" = "$golden" ]; then
      echo "refusing: $rundir is the golden DB" >&2; exit 1
    fi
    for d in chain db ipc; do
      [ -d "$rundir/$d" ] || { echo "missing $rundir/$d" >&2; exit 1; }
    done
    docker inspect -f '{{.State.Running}}' "$FORGER" 2>/dev/null | grep -q true || {
      echo "refusing: $FORGER is not running; the follower joins its network namespace" >&2
      exit 1
    }
    # env files, same convention as scripts/isolated-node
    envargs=()
    for f in fork.env faketime.env; do
      if [ -f "$rundir/chain/$f" ]; then
        envargs+=(--env-file "$rundir/chain/$f")
        echo "$f:"; sed 's/^/  /' "$rundir/chain/$f"
      fi
    done
    if [ -f "$rundir/chain/faketime.env" ]; then
      dfm=$(sed -n 's/^FAKETIME_DONT_FAKE_MONOTONIC=//p' "$rundir/chain/faketime.env" | tail -1)
      envargs+=(-e "FAKETIME_DONT_FAKE_MONOTONIC=${dfm:-1}")
    fi
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker run -d --name "$NAME" \
      --platform linux/amd64 \
      --label devnet.run=follower \
      --label "devnet.run.dir=$rundir" \
      --network "container:$FORGER" \
      --user "$MY_UID:$MY_GID" \
      --stop-signal SIGINT \
      "${envargs[@]}" \
      -v "$rundir:/rundir" \
      -v "$rundir/ipc:/ipc" \
      --entrypoint /usr/local/bin/cardano-node \
      "$IMAGE" \
      run --config /rundir/chain/config.json \
          --topology /rundir/chain/topology.json \
          --database-path /rundir/db \
          --socket-path /ipc/node.socket \
          --host-addr 127.0.0.1 --port 3002 >/dev/null
    echo "follower started; socket at $rundir/ipc/node.socket"
    ;;
  stop)
    NAME=$(container_for "${1:?usage: follower-node stop <run dir>}")
    sock=$(docker inspect "$NAME" \
             --format '{{range .Mounts}}{{if eq .Destination "/ipc"}}{{.Source}}{{end}}{{end}}' \
             2>/dev/null)/node.socket
    docker stop "$NAME"
    [ -S "$sock" ] && rm -f "$sock" && echo "removed stale socket $sock"
    ;;
  logs)
    NAME=$(container_for "${1:?usage: follower-node logs <run dir> [-f]}"); shift
    docker logs "$@" "$NAME"
    ;;
  cli)
    rundir=$(realpath "${1:?usage: follower-node cli <run dir> <args...>}"); shift
    NAME=$(container_for "$rundir")
    FORGER=$(container_for "$(basename "${rundir%-follower}")")
    docker run --rm -i \
      --network "container:$FORGER" \
      --user "$MY_UID:$MY_GID" \
      --volumes-from "$NAME" \
      -e CARDANO_NODE_SOCKET_PATH=/ipc/node.socket \
      --entrypoint /usr/local/bin/cardano-cli \
      "$IMAGE" "$@"
    ;;
  *)
    sed -n '3,40p' "$0"
    exit 1
    ;;
esac
